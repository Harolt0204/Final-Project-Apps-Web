# Copy this file to `.env` (project root) and adjust the values.
# `.env` is ignored by git: never commit real passwords or secrets.

# --- Docker Compose (MySQL container) ---
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=thesis_management
MYSQL_USER=thesis_app
MYSQL_PASSWORD=thesis_dev_password
MYSQL_HOST_PORT=3307

# --- Backend (FastAPI) ---
# development | production (production refuses to start with a weak JWT_SECRET)
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://thesis_app:thesis_dev_password@127.0.0.1:3307/thesis_management?charset=utf8mb4
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Gmail defense notifications (local demo) ---
GMAIL_DEMO_ENABLED=false
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_TEST_RECIPIENT=
